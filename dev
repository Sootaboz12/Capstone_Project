#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# Each checkout gets its own dependencies, including separate Git worktrees.
project_id="$(printf '%s' "$project_dir" | cksum | cut -d ' ' -f 1)"
container_name="capstone-dev-$project_id"
container_image="localhost/capstone-dev:latest"

if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
  cat <<EOF
Usage: ./dev [dev | command [args...]]

Build the image first (from the project root):
  podman build --tag "$container_image" --file Containerfile.dev .

  ./dev                 Open a Fish container terminal
  ./dev dev             Start Vite at http://localhost:5173
  ./dev npm ci          Install dependencies from package-lock.json
  ./dev npm run lint    Run Oxlint
  ./dev npm run build   Type-check and build into dist/
  ./dev bash            Open a container terminal

Notebook workflow (from the project root):
  Edit on the host:     nvim src/model/model_testing.py
  Sync after editing:  ./dev uv run jupytext --sync src/model/model_testing.py
  Run the model:       ./dev uv run python src/model/model_testing.py

Saving the Python file does not update the notebook automatically; run sync
after editing either file to update the pair before running or committing.
Agents must get explicit user permission before running the model; it uses
substantial resources. Notebook sync does not execute the model.

Set PODMAN_DEV_PORT to change the host port (default: 5173).
Development container: $container_name
EOF
  exit 0
fi

if ! command -v podman >/dev/null 2>&1; then
  printf 'Podman is required. Install it and verify that podman info works.\n' >&2
  exit 1
fi
if [[ "$(id -u)" == 0 ]]; then
  printf 'Run ./dev as your regular user so Podman runs rootless.\n' >&2
  exit 1
fi

podman_args=(
  --rm --init --interactive
  --userns keep-id
  --cap-drop all
  --security-opt no-new-privileges
  --workdir /workspace
  --env npm_config_cache=/tmp/npm-cache
  --volume "$project_dir:/workspace:z"
)
if [[ -t 0 && -t 1 ]]; then
  podman_args+=(--tty)
fi

if [[ "${1:-}" == dev ]]; then
  shift
  podman_args+=(
    --name "$container_name"
    --publish "127.0.0.1:${PODMAN_DEV_PORT:-5173}:5173"
  )
  set -- npm run dev -- --host 0.0.0.0 --port 5173 --strictPort "$@"
fi

exec podman run "${podman_args[@]}" "$container_image" "$@"
