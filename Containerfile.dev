FROM docker.io/library/node:24-bookworm-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/

ENV SHELL=/usr/bin/fish \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates fish \
    && uv python install 3.12 \
    && ln -s "$(uv python find 3.12)" /usr/local/bin/python \
    && ln -s /usr/local/bin/python /usr/local/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT []
CMD ["fish"]
